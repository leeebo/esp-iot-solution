# ESP32-P4 Target Configuration
CONFIG_IDF_TARGET="esp32p4"

# Enable WiFi connection in protocol_examples_common
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CONNECT_ETHERNET=n
CONFIG_EXAMPLE_WIFI_SSID="HAPPYBOY"
CONFIG_EXAMPLE_WIFI_PASSWORD="43539100"

# ESP-WiFi-Remote Configuration (MUST be set first)
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# ESP-Hosted Configuration (P4 Function EV Board with on-board C6)
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y

# HTTP Server Configuration
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# Increase main task stack size for WiFi and MCP
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable mDNS
CONFIG_MDNS_MAX_SERVICES=10

# Custom partition table with larger app partition
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Flash size (P4 EV board has 16MB flash)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
